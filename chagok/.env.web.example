# compose.web.yaml 전용. 기존 인프라 .env와 DB 볼륨을 공유하지 않는다.
DB_NAME=chagok
DB_USERNAME=postgres
DB_PASSWORD=
WEB_PORT=8080
WEB_BIND_ADDRESS=127.0.0.1
CLIENT_CONTEXT=../client

# 처음 실행할 때 직접 지정한 계정 생성. 생성 후 false로 바꿀 수 있다.
BOOTSTRAP_ENABLED=true
BOOTSTRAP_EMPLOYEE_ID=local-operator
BOOTSTRAP_PASSWORD=
BOOTSTRAP_USER_NAME=배포 테스트 운영자
BOOTSTRAP_WAREHOUSE_NAME=배포 테스트 센터

# 처음에는 빈 DB이므로 정기 재계산은 끈다. 수동 DB 계산은 사용할 수 있다.
JOB_SCHEDULING_ENABLED=false
SESSION_COOKIE_SECURE=false
# HTTPS 프록시 뒤에서는 SESSION_COOKIE_SECURE=true와 실제 origin을 지정한다.
CORS_ALLOWED_ORIGINS=http://localhost:8080
