DB_NAME=chagok
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/chagok
DB_USERNAME=postgres
DB_PASSWORD=postgres
DDL_AUTO=update

# 로컬 Kafka(compose.yaml). 애플리케이션 기본값과 같으므로 포트를 바꿀 때만 수정한다
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Spring 기동 중 정기 작업 접수(5분마다 이번 달·다음 달)와 대기 작업 실행
JOB_SCHEDULING_ENABLED=true
JOB_WORKER_ENABLED=true
# JOB_CRON=0 */5 * * * *
