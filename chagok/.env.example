DB_NAME=chagok
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/chagok
DB_USERNAME=postgres
DB_PASSWORD=postgres
DDL_AUTO=update
SQL_INIT_MODE=always

# 로컬 Kafka(compose.yaml). 애플리케이션 기본값과 같으므로 포트를 바꿀 때만 수정한다
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Spring 기동 중 정기 작업 접수(5분마다 이번 달·다음 달)와 대기 작업 실행
JOB_SCHEDULING_ENABLED=true
JOB_WORKER_ENABLED=true
# JOB_CRON=0 */5 * * * *

# 세션 인증은 기본 활성화. 프론트에서는 credentials: include와 CSRF 토큰을 사용한다.
AUTH_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false

# 계정이 없는 로컬 DB에서만 명시적으로 활성화한다. 비밀번호는 직접 지정한다.
BOOTSTRAP_ENABLED=false
# BOOTSTRAP_EMPLOYEE_ID=local-operator
# BOOTSTRAP_PASSWORD=
# BOOTSTRAP_USER_NAME=로컬 운영자
# BOOTSTRAP_WAREHOUSE_ID=
# BOOTSTRAP_WAREHOUSE_NAME=차곡 로컬 센터

# 에이전트(business-mcp) 내부 API(/internal/**) 토큰. 비어 있으면 내부 API 전부 거부. box_agent/.env 와 같은 값
INTERNAL_API_TOKEN=

# 박스 주문 제안 에이전트 서버 주소(box_agent agent_server.py). 비어 있으면 AI 작업 API 는 503
AGENT_API_URL=

# 라이브 표본 재생·차감과 매시 정각/30분 초기화. 기능을 켜도 Play 전에는 입력 정지.
LIVE_FEEDER_ENABLED=false
LIVE_FEEDER_INTERVAL_MS=167
LIVE_RESET_ENABLED=false
LIVE_RESET_CRON=0 */30 * * * *
# 승인된 클라우드 DB에서 라이브 쓰기를 사용할 때만 true. 자동 DDL은 별도로 끈다.
LIVE_ALLOW_REMOTE_DATABASE=false
# 클라우드: DB_URL을 실제 대상에 지정하고 DDL_AUTO=none, SQL_INIT_MODE=never 사용.
